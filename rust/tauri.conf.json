{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hx-bib",
  "mainBinaryName": "hx-bib-desktop",
  "version": "0.1.0",
  "identifier": "com.haidongxin.hx-bib",
  "build": { "frontendDist": "web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "hx-bib", "width": 1320, "height": 860, "minWidth": 900, "minHeight": 600, "visible": false, "titleBarStyle": "Overlay", "hiddenTitle": true, "trafficLightPosition": { "x": 16, "y": 26 } }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
